# Syntropy — variables de entorno de ejemplo
# Copiar este archivo a .env.local y completar con los datos de TU proyecto.
# Guía paso a paso: docs/fase-1/08-configuracion-supabase.md
# .env.local NO se versiona. Nunca commitear claves reales.

# ---------------------------------------------------------------------------
# Frontend (Vite)
# Son variables públicas: cualquiera puede verlas en el bundle.
# La seguridad real depende de RLS y de no exponer la service_role.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY_PUBLICA
VITE_APP_URL=http://localhost:5173
VITE_APP_ENV=development

# Datos del responsable que muestran los términos y la política de privacidad.
# Son públicos (aparecen en /legal/...). Obligatorios antes de publicar.
VITE_LEGAL_OWNER=Nombre y apellido o razón social
VITE_LEGAL_CONTACT_EMAIL=contacto@tudominio.com
VITE_LEGAL_LOCATION=Ciudad, Provincia, Argentina

# ---------------------------------------------------------------------------
# Secretos de servidor — NO van en Vite ni en el navegador.
# Son secretos de la Edge Function send-reminders (Fase 7):
#   supabase secrets set RESEND_API_KEY=... REMINDER_FROM_EMAIL=... CRON_SECRET=... APP_URL=...
# Guía: docs/fase-7/README.md
# ---------------------------------------------------------------------------
# RESEND_API_KEY=re_TU_CLAVE
# REMINDER_FROM_EMAIL=Syntropy <recordatorios@tudominio.com>
# CRON_SECRET=una_cadena_larga_y_aleatoria (la misma que se guarda en Vault)
# APP_URL=https://tu-dominio.com (para los enlaces del correo)

# La service_role omite RLS. Solo puede existir en un entorno de servidor
# controlado; nunca en el frontend, en Tauri, en Capacitor ni en este archivo.
# SUPABASE_SERVICE_ROLE_KEY=NO_USAR_EN_EL_CLIENTE

# ---------------------------------------------------------------------------
# Empaquetado (se completará en las fases correspondientes)
# ---------------------------------------------------------------------------
# VITE_APP_VERSION=0.1.0
# Identificador aprobado: com.syntropy.app (D12)
