# Syntropy — variables de entorno de ejemplo
# Copiar este archivo a .env.local y completar con los datos de TU proyecto.
# .env.local NO se versiona. Nunca commitear claves reales.

# ---------------------------------------------------------------------------
# Frontend (Vite)
# Son variables públicas: cualquiera puede verlas en el bundle.
# La seguridad real depende de RLS y de no exponer la service_role.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY_PUBLICA
VITE_APP_URL=http://localhost:5173
VITE_APP_ENV=development

# ---------------------------------------------------------------------------
# Secretos de servidor — NO van en Vite ni en el navegador.
# Se configuran como secretos de Supabase Edge Functions en la Fase 7:
#   supabase secrets set RESEND_API_KEY=... REMINDER_FROM_EMAIL=...
# ---------------------------------------------------------------------------
# RESEND_API_KEY=re_TU_CLAVE
# REMINDER_FROM_EMAIL=recordatorios@tudominio.com

# La service_role omite RLS. Solo puede existir en un entorno de servidor
# controlado; nunca en el frontend, en Tauri, en Capacitor ni en este archivo.
# SUPABASE_SERVICE_ROLE_KEY=NO_USAR_EN_EL_CLIENTE

# ---------------------------------------------------------------------------
# Empaquetado (se completará en las fases correspondientes)
# ---------------------------------------------------------------------------
# VITE_APP_VERSION=0.1.0
# Identificador aprobado: com.syntropy.app (D12)
